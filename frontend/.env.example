# Copy this file to .env.local and fill in your deployed contract address.

# The deployed SkyVerdict contract address.
VITE_SKYVERDICT_ADDRESS=0xDa95D4851E848C7fE030FC848596625Edb2d905c

# Which genlayer-js chain preset to use: studionet | testnetAsimov | localnet
VITE_GENLAYER_CHAIN=studionet

# RPC endpoint override.
#
# Leave unset for local dev against a network whose RPC allows direct
# browser calls (e.g. a local `genlayer up` localnet).
#
# On Vercel (or any deployed origin), hosted Studio's API blocks direct
# cross-origin calls from the browser (CORS) — set this to the literal
# string "same-origin" to route through this project's own /api/rpc
# serverless proxy instead, which forwards the request server-side where
# CORS doesn't apply. See docs/genvm-gotchas.md #7 and frontend/api/rpc.js.
VITE_GENLAYER_RPC_URL=same-origin
